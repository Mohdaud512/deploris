# =============================================================================
# Deploris — environment variables (example)
# Copy to `.env.local` for dev; configure the real values in Vercel Project Settings
# for preview + production. NEVER commit real secrets to git.
# =============================================================================

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://deploris.com
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Contact form / transactional email (Resend) -----------------------------
# Get a key at https://resend.com/api-keys. Verify your sending domain and
# add SPF, DKIM, DMARC per CONTENT.md before going live.
RESEND_API_KEY=re_replace_me
RESEND_FROM="Deploris <noreply@deploris.com>"
CONTACT_INBOX=muhammad.daud@deploris.com
QUOTE_INBOX=muhammad.daud@deploris.com
NEWSLETTER_INBOX=muhammad.daud@deploris.com
DATA_REQUEST_INBOX=muhammad.daud@deploris.com

# --- Team notification webhook (Slack or Teams) ------------------------------
# When present, every lead posts a summary here for real-time follow-up.
LEAD_NOTIFICATION_WEBHOOK_URL=

# --- Spam protection (hCaptcha) ----------------------------------------------
# https://dashboard.hcaptcha.com/sites
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000

# --- Rate limiting (Upstash Redis, EU region) --------------------------------
# https://console.upstash.com — create a Redis DB in eu-west-1 for GDPR.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- AI chatbot (Grok / xAI, RAG-grounded) -----------------------------------
# Keep server-side only. The chatbot route reads this and streams responses.
# When absent, the /api/chat route returns a clearly-marked stub answer.
# TODO: connect Grok — paste the real key here to switch from stub to live.
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# --- Analytics (all consent-gated, deny-by-default) --------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=deploris.com
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# --- Consent Management Platform --------------------------------------------
# Pick one: Usercentrics OR Cookiebot. Leave the other blank.
NEXT_PUBLIC_USERCENTRICS_ID=
NEXT_PUBLIC_COOKIEBOT_ID=

# --- Optional integrations ---------------------------------------------------
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
